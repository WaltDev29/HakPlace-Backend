# API 서버 설정 예시

# 데이터베이스 연결 URL (도커 내부 연결 시 @db 사용)
# 형식: mysql+pymysql://[유저]:[비밀번호]@db:3306/[DB명]
DATABASE_URL=mysql+pymysql://hakplace_user:hakplace_pwd@db:3306/hakplace_db

# 애플리케이션 실행 환경 (development, production)
APP_ENV=development

# JWT 토큰 암호화용 시크릿 키 (보안을 위해 복잡한 임의 문자열 권장)
# 생성 예시: openssl rand -hex 32
SECRET_KEY=your_secret_key_here

# OpenAI API 키 (AI 분석 기능을 위해 필요)
LLM_API_KEY=your_openai_api_key_here
